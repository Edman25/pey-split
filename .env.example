# Copiar a .env (local) o a Vercel → Settings → Environment Variables. Nunca subir valores.

# URL pública de la app, sin "/" final. Local: http://localhost:3000
# pey exige HTTPS en successUrl/backUrl: con PEY_MODE=real usar la URL de Vercel.
APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Solo para conectarse con psql; la app no la usa.
SUPABASE_DB_PASSWORD=

# pey: simulado | real
PEY_MODE=simulado
PEY_API_URL=https://api.pey.mx
PEY_API_KEY=
# Secreto del webhook (formato whsec_...), portal.mipey.mx → Desarrollador
PEY_WEBHOOK_SECRET=
